{
  "expo": {
    "name": "Loqzen Kiosk",
    "slug": "loqzen-kiosk",
    "owner": "williamaguirre82",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "loqzen-kiosk",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2237"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "isTabletOnly": true,
      "bundleIdentifier": "com.loqzen.kiosk",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Loqzen Kiosk takes a photo when an employee clocks in or out, so managers can confirm who punched.",
        "NSLocationWhenInUseUsageDescription": "Loqzen Kiosk records the tablet's location with each clock-in and clock-out to confirm punches happen at the work site.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.loqzen.kiosk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A6B47"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Loqzen Kiosk takes a photo when an employee clocks in or out, so managers can confirm who punched.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Loqzen Kiosk records the tablet's location with each clock-in and clock-out to confirm punches happen at the work site.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "privacyPolicyUrl": "https://loqzen.com/privacy",
      "termsUrl": "https://loqzen.com/terms"
    }
  }
}
