# API Configuration (Expo runtime reads EXPO_PUBLIC_*)
EXPO_PUBLIC_API_URL=https://localhost:5001
EXPO_PUBLIC_API_TIMEOUT=30000
# Web app base URL: "Create one" on the login screen opens {APP_URL}/register, and upgrade opens {APP_URL}/upgrade
EXPO_PUBLIC_APP_URL=https://app.loqzen.com

# Firebase Configuration (Expo runtime requires EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# AWS S3 (for photo uploads)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=shiftwork-photos

# App Configuration
EXPO_PUBLIC_DEFAULT_COMPANY_ID=your-company-id
# Origin of the Angular web app (no trailing path). The Upgrade tab opens <url>/dashboard/billing.
EXPO_PUBLIC_APP_URL=https://app.loqzen.com

# MCP Server (Python AI/tool server)
EXPO_PUBLIC_MCP_URL=http://localhost:8080
