# Copy this file to .env in the repository root before running:
# docker compose up --build

# SQL Server
SA_PASSWORD=Your_password123
# api's docker-compose service reads this directly — without it, `docker compose up --build`
# fails at API startup even though this file didn't previously mention it.
DB_CONNECTION_STRING=Server=mssql;Database=ShiftWork;User Id=sa;Password=Your_password123;TrustServerCertificate=True;

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Firebase (required by API startup)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_API_KEY=your-firebase-web-api-key

# AWS S3 (AWS_REGION is required by API startup)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# MCP / API access token (optional)
API_AUTH_TOKEN=

# Weather API (optional)
OPENWEATHER_API_KEY=

# Push notifications (optional)
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# Observability (Prometheus + Grafana — see Docs/W6_DASHBOARDS_AND_ALERTS.md)
# Shared secret Prometheus presents to the API's /metrics scrape endpoint. Generate with e.g.
# `openssl rand -hex 32` — must match between here and observability/prometheus/prometheus.yml's
# templated scrape config (see that file's comments for how it's substituted in).
METRICS_SCRAPE_TOKEN=change-me-to-a-long-random-value
# Grafana admin login (user: admin). Change on first login in production.
GRAFANA_ADMIN_PASSWORD=change-me
# Recipient for Grafana's provisioned alert rules (reuses the app's own SMTP_* credentials above
# as the sender).
GRAFANA_ALERT_EMAIL=ops@example.com
