# API Configuration
API_URL=http://localhost:5182/api
#API_URL=https://api.loqzen.com/api
API_TIMEOUT=30000

# MCP Server
MCP_URL=http://localhost:8080
#MCP_URL=https://mcp.loqzen.com

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=loqzen.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# AWS S3 (for photo uploads)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=loqzen-photos
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# App Configuration
DEFAULT_COMPANY_ID=your-company-id
APP_NAME=Loqzen
APP_DOMAIN=loqzen.com
