{
  "title": "ShiftWork — API Health",
  "uid": "shiftwork-api-health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["shiftwork"],
  "panels": [
    {
      "id": 1,
      "title": "API up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "shiftwork-prometheus" },
      "targets": [
        { "expr": "up{job=\"shiftwork-api\"}", "legendFormat": "up" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "5xx error rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "shiftwork-prometheus" },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{job=\"shiftwork-api\", http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"shiftwork-api\"}[5m]))",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 3,
      "title": "Request volume by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "shiftwork-prometheus" },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"shiftwork-api\"}[5m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 latency — priority endpoints (bulletins, documents, safety, daily-reports, auth/login, kiosk clock)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "shiftwork-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"shiftwork-api\", http_route=~\".*(bulletins|documents|safety|daily-reports|auth/login|kiosk.*clock).*\"}[5m])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "thresholds": { "steps": [{ "value": 1.5, "color": "orange" }, { "value": 3, "color": "red" }] }
    },
    {
      "id": 5,
      "title": "p99 latency — all routes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "shiftwork-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"shiftwork-api\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "Readiness (/health/ready implied by API up + DB health)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "shiftwork-prometheus" },
      "targets": [
        { "expr": "up{job=\"shiftwork-api\"}", "legendFormat": "API process up" }
      ]
    }
  ]
}
